# ─────────────────────────────────────────────
# XBot — Geopolitical News Bot Configuration
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Anthropic API key (for Claude research + content generation)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── X (Twitter) API v2 Credentials ───────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Required access level: "Read and Write" (for posting tweets)
# Apply for Elevated access if you're posting >50 tweets/day

# OAuth 1.0a keys (required for posting)
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Optional: Bearer token (for read-only operations)
X_BEARER_TOKEN=your_bearer_token_here

# ── Bot Configuration ─────────────────────────────────────────────────────────

# Database file path (SQLite, auto-created)
XBOT_DB_PATH=xbot_data.db

# Port for the web dashboard
PORT=8001

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
