# GreymatterAI — Environment Variables
# Copy to .env and fill in your real values. Never commit .env to git.

# ---------------------------------------------------------------------------
# Required — Data
# ---------------------------------------------------------------------------
TWELVE_DATA_API_KEY=your_twelve_data_api_key
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/greymatter

# ---------------------------------------------------------------------------
# AI Learning Engine (pick ONE provider — gemini is the free default)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini          # gemini | deepseek | groq | claude

# Gemini Flash — completely FREE, no credit card required
# pip install google-generativeai  |  Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek V3 — free credits on signup, ~$0.001/analysis after
# pip install openai  |  Key: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq (Llama 3.3 70B) — 14,400 free requests/day
# pip install groq  |  Key: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# Claude Haiku — requires separate Anthropic API billing (NOT included in Pro)
# pip install anthropic  |  Key: https://console.anthropic.com
# CLAUDE_API_KEY=your_claude_api_key_here

# ---------------------------------------------------------------------------
# Account (IMPORTANT — set this to your actual account balance)
# ---------------------------------------------------------------------------
ACCOUNT_SIZE_USD=250             # your real account balance in USD
LEVERAGE=500                     # your broker's leverage (e.g. 500 for 1:500)
MIN_LOT_SIZE=0.01                # minimum lot size your broker allows

# ---------------------------------------------------------------------------
# MetaTrader 5
# ---------------------------------------------------------------------------
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Live       # found in MT5 login screen
MT5_SYMBOL=US100                 # NAS100 symbol: US100 / NAS100 / US100Cash (broker-specific)
MT5_POINT_VALUE=1.0              # USD per point per 1.0 lot (ICMarkets/Pepperstone = 1.0)

# ---------------------------------------------------------------------------
# Telegram Alerts (optional but recommended for 24/7 monitoring)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---------------------------------------------------------------------------
# Twelve Data symbol (for OHLCV data when MT5 not connected)
# ---------------------------------------------------------------------------
TD_SYMBOL=QQQ
